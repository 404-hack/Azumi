{
  "name": "@repo/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "pnpm run build && wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types && move worker-configuration.d.ts src/",
    "db:push": "drizzle-kit push --config=drizzle-dev.config.ts",
    "db:push:prod": "drizzle-kit push",
    "db:migrate:prod": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate --config=drizzle-dev.config.ts",
    "db:studio:prod": "drizzle-kit studio",
    "db:studio": "drizzle-kit studio --config=drizzle-dev.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@eslint/compat": "^1.2.3",
    "@eslint/js": "^9.17.0",
    "@internationalized/date": "^3.7.0",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/adapter-cloudflare": "^5.0.1",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/nprogress": "^0.2.3",
    "autoprefixer": "^10.4.20",
    "bits-ui": "1.0.0-next.85",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.30.3",
    "embla-carousel-svelte": "^8.5.2",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.36.0",
    "formsnap": "^2.0.0",
    "globals": "^15.0.0",
    "lucide-svelte": "^0.472.0",
    "mode-watcher": "^0.5.0",
    "prettier": "^3.3.2",
    "prettier-plugin-svelte": "^3.2.6",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "svelte": "^5.27.0",
    "svelte-check": "^4.0.0",
    "svelte-sonner": "^0.3.28",
    "sveltekit-superforms": "^2.23.1",
    "tailwind-merge": "^2.6.0",
    "tailwind-variants": "^0.3.0",
    "tailwindcss": "^3.4.9",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vaul-svelte": "1.0.0-next.3",
    "vite": "^5.4.11",
    "wrangler": "^4.4.0",
    "zod": "^3.24.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "@googlemaps/js-api-loader": "^1.16.8",
    "@libsql/client": "^0.14.0",
    "@mapbox/search-js-core": "^1.0.0",
    "@mapbox/search-js-web": "^1.0.0",
    "@number-flow/svelte": "^0.3.7",
    "@paystack/inline-js": "^2.22.2",
    "@repo/server": "workspace:*",
    "@repo/types": "workspace:*",
    "better-auth": "^1.1.18",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.0",
    "mapbox-gl": "^3.10.0",
    "maplibre-gl": "^5.2.0",
    "nanoid": "^5.0.9",
    "nprogress": "^0.2.0",
    "runed": "^0.24.1",
    "svelte-confetti": "^2.3.1",
    "sveltekit-search-params": "^3.0.0"
  }
}