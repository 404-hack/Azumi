<script lang="ts">
  import { networkStatus } from '$lib/stores/network';
  import { page } from '$app/stores';
  import { goto } from '$app/navigation';
  import { onMount } from 'svelte';
  
  let { children } = $props();
  let isRedirecting = false;
  
  onMount(() => {
    // If we navigate to offline page but we are online, redirect to home
    const unsubscribe = networkStatus.subscribe((online) => {
      if (online && $page.url.pathname === '/offline' && !isRedirecting) {
        isRedirecting = true;
        goto('/');
      }
    });
    
    return unsubscribe;
  });
</script>

{#if !$networkStatus && $page.url.pathname !== '/offline'}
  <div class="fixed bottom-4 left-4 z-50 rounded-lg bg-yellow-50 p-4 shadow-md">
    <div class="flex items-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="mr-3 h-5 w-5 text-yellow-600" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
      </svg>
      <div>
        <p class="text-sm font-medium text-yellow-800">You are browsing in offline mode</p>
        <p class="text-xs text-yellow-700">Some content may be unavailable</p>
      </div>
    </div>
  </div>
{/if}

{@render children()}
