<script lang="ts">
	import { Badge } from '$lib/components/ui/badge';
	import { Button } from '$lib/components/ui/button';
	import { Card, CardContent, CardHeader, CardTitle } from '$lib/components/ui/card';
	import { ArrowLeft, Clock, MapPin, User, CheckCircle, Phone } from 'lucide-svelte';
	import { formatCurrency } from '$lib/utils';
	import { goto } from '$app/navigation';
	import { client } from '$lib/hc';
	import type { PageData } from './$types';
	
	let { data }: { data: PageData } = $props();
	let order = $state(data.order);
	let isUpdating = $state(false);

	const statusColors = {
		PENDING: 'bg-yellow-500 text-white',
		PAYMENT_CONFIRMED: 'bg-blue-500 text-white',
		CONFIRMED: 'bg-green-500 text-white',
		READY: 'bg-purple-500 text-white',
		RIDER_ASSIGNED: 'bg-orange-500 text-white',
		IN_TRANSIT: 'bg-indigo-500 text-white',
		DELIVERED: 'bg-emerald-500 text-white',
		COMPLETED: 'bg-gray-500 text-white',
		CANCELLED: 'bg-red-500 text-white'
	};

	const getNextAction = (status: string) => {
		switch (status) {
			case 'PAYMENT_CONFIRMED': return { status: 'CONFIRMED', text: 'Accept Order' };
			case 'CONFIRMED': return { status: 'READY', text: 'Mark Ready' };
			default: return null;
		}
	};

	async function updateOrderStatus(newStatus: string) {
		if (isUpdating) return;
		
		try {
			isUpdating = true;
			const response = await client.order[':id'].status.$patch({
				param: { id: order.id },
				json: { status: newStatus }
			});
			if (response.ok) {
				order = { ...order, status: newStatus };
			}
		} catch (error) {
			console.error('Error:', error);
		} finally {
			isUpdating = false;
		}
	}
</script>

<div class="min-h-screen bg-gray-50 p-2 sm:p-4">
	<div class="mx-auto max-w-md space-y-4">
		<!-- Header -->
		<div class="flex items-center gap-3 bg-white p-4 rounded-lg shadow-sm">
			<Button variant="ghost" size="sm" onclick={() => goto('/vendor/orders')}>
				<ArrowLeft class="h-4 w-4" />
			</Button>
			<div class="flex-1">
				<h1 class="text-lg font-bold">Order #{order.code || order.id.slice(-6)}</h1>
				<div class="text-sm text-gray-500">{new Date(order.createdAt).toLocaleDateString()}</div>
			</div>
		</div>

		<!-- Status Card -->
		<Card>
			<CardContent class="p-4">
				<div class="flex items-center justify-between mb-4">
					<div class="flex items-center gap-2">
						<Clock class="h-4 w-4 text-gray-500" />
						<span class="font-medium">Status</span>
					</div>
					<Badge class={statusColors[order.status] || 'bg-gray-500 text-white'}>
						{order.status.replace('_', ' ')}
					</Badge>
				</div>
				
				{#if getNextAction(order.status)}
					<Button 
						class="w-full" 
						onclick={() => updateOrderStatus(getNextAction(order.status).status)}
						disabled={isUpdating}
					>
						{isUpdating ? 'Updating...' : getNextAction(order.status).text}
					</Button>
				{/if}
			</CardContent>
		</Card>

		<!-- Customer Info -->
		<Card>
			<CardContent class="p-4">
				<div class="flex items-center gap-2 mb-3">
					<User class="h-4 w-4 text-gray-500" />
					<span class="font-medium">Customer</span>
				</div>
				<div class="space-y-2">
					<div class="flex items-center gap-2">
						<span class="text-sm">{order.customer?.name || 'Customer'}</span>
					</div>
					{#if order.customer?.phone}
						<div class="flex items-center gap-2">
							<Phone class="h-3 w-3 text-gray-400" />
							<span class="text-sm text-gray-600">{order.customer.phone}</span>
						</div>
					{/if}
				</div>
			</CardContent>
		</Card>

		<!-- Delivery Address -->
		<Card>
			<CardContent class="p-4">
				<div class="flex items-center gap-2 mb-3">
					<MapPin class="h-4 w-4 text-gray-500" />
					<span class="font-medium">Delivery Address</span>
				</div>
				<div class="text-sm text-gray-600">
					{order.addressName || 'Address not provided'}
				</div>
				{#if order.deliveryNotes}
					<div class="mt-2 p-2 bg-gray-50 rounded text-sm">
						<strong>Note:</strong> {order.deliveryNotes}
					</div>
				{/if}
			</CardContent>
		</Card>

		<!-- Order Items -->
		<Card>
			<CardHeader class="pb-3">
				<CardTitle class="text-base">Order Items</CardTitle>
			</CardHeader>
			<CardContent class="p-4 pt-0">
				<div class="space-y-3">
					{#each order.items || [] as item}
						<div class="flex justify-between items-start">
							<div class="flex-1">
								<div class="font-medium text-sm">{item.menuItemName}</div>
								<div class="text-xs text-gray-500">Qty: {item.quantity}</div>
								{#if item.specialInstructions}
									<div class="text-xs text-gray-600 mt-1">Note: {item.specialInstructions}</div>
								{/if}
							</div>
							<div class="text-sm font-medium">
								{formatCurrency(item.totalPrice)}
							</div>
						</div>
					{/each}
				</div>
			</CardContent>
		</Card>

		<!-- Order Total -->
		<Card>
			<CardContent class="p-4">
				<div class="space-y-2">
					<div class="flex justify-between text-sm">
						<span>Subtotal</span>
						<span>{formatCurrency(order.subtotal)}</span>
					</div>
					{#if order.deliveryFee > 0}
						<div class="flex justify-between text-sm">
							<span>Delivery Fee</span>
							<span>{formatCurrency(order.deliveryFee)}</span>
						</div>
					{/if}
					{#if order.serviceFee > 0}
						<div class="flex justify-between text-sm">
							<span>Service Fee</span>
							<span>{formatCurrency(order.serviceFee)}</span>
						</div>
					{/if}
					{#if order.discount > 0}
						<div class="flex justify-between text-sm text-green-600">
							<span>Discount</span>
							<span>-{formatCurrency(order.discount)}</span>
						</div>
					{/if}
					<hr class="my-2" />
					<div class="flex justify-between font-bold">
						<span>Total</span>
						<span>{formatCurrency(order.total)}</span>
					</div>
					<div class="text-xs text-gray-500 text-center">
						Payment: {order.paymentMethod} • {order.paymentStatus}
					</div>
				</div>
			</CardContent>
		</Card>

		<!-- Quick Actions -->
		{#if order.status !== 'DELIVERED' && order.status !== 'CANCELLED' && order.status !== 'COMPLETED'}
			<Card>
				<CardContent class="p-4">
					<div class="space-y-2">
						{#if order.status === 'PAYMENT_CONFIRMED' || order.status === 'CONFIRMED'}
							<Button 
								variant="destructive" 
								size="sm" 
								class="w-full"
								onclick={() => updateOrderStatus('CANCELLED')}
								disabled={isUpdating}
							>
								Cancel Order
							</Button>
						{/if}
						{#if order.customer?.phone}
							<Button 
								variant="outline" 
								size="sm" 
								class="w-full"
								onclick={() => window.open(`tel:${order.customer.phone}`)}
							>
								Call Customer
							</Button>
						{/if}
					</div>
				</CardContent>
			</Card>
		{/if}
	</div>
</div>
